####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/MicroDesktop/bin || mkdir -p $(INSTALL_ROOT)/opt/MicroDesktop/bin
	$(QINSTALL_PROGRAM) ../../../desktop/MicroDesktop/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/MicroDesktop/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/MicroDesktop/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/MicroDesktop/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

