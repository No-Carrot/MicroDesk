####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Mqtt/bin || mkdir -p $(INSTALL_ROOT)/opt/Mqtt/bin
	$(QINSTALL_PROGRAM) ../../../desktop/Mqtt/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/Mqtt/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/Mqtt/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Mqtt/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

