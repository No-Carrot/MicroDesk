sub-core-check_ordered:
	@test -d core/ || mkdir -p core/
	cd core/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/linux/emb/14-desktop/im/core/core.pro -spec devices/linux-buildroot-g++ ) && $(MAKE) -f Makefile check
