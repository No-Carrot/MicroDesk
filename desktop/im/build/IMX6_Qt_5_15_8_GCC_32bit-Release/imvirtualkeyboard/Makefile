	@test -d $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/lib/qt/plugins/platforminputcontexts || mkdir -p $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/lib/qt/plugins/platforminputcontexts
	$(QINSTALL_PROGRAM) ../../../../desktop/im/plugins/platforminputcontexts/$(TARGET) $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/lib/qt/plugins/platforminputcontexts/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/lib/qt/plugins/platforminputcontexts/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/lib/qt/plugins/platforminputcontexts/ 


