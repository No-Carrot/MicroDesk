	$(QINSTALL) /home/linux/emb/14-desktop/im/imvirtualkeyboard/pinyininputmethod/pinyin/data $(INSTALL_ROOT)/home/linux/emb/buildroot/output/host/arm-imx6-linux-musleabihf/sysroot/usr/share/pinyin/3rdparty/pinyin/data

