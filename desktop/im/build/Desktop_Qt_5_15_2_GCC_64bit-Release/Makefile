	cd ui/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/linux/emb/14-desktop/im/ui/ui.pro -spec linux-g++ CONFIG+=qtquickcompiler ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/ui

sub-imvirtualkeyboard-distdir: FORCE
	@test -d imvirtualkeyboard/ || mkdir -p imvirtualkeyboard/
	cd imvirtualkeyboard/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/linux/emb/14-desktop/im/imvirtualkeyboard/imvirtualkeyboard.pro -spec linux-g++ CONFIG+=qtquickcompiler ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/imvirtualkeyboard

