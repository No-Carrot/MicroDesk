	@test -d ../../../../desktop/im/lib/ || mkdir -p ../../../../desktop/im/lib/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../../../desktop/im/lib/$(TARGET)
	-$(MOVE) $(TARGET) ../../../../desktop/im/lib/$(TARGET)
	-$(DEL_FILE) ../../../../desktop/im/lib/$(TARGET0)
	-$(DEL_FILE) ../../../../desktop/im/lib/$(TARGET1)
	-$(DEL_FILE) ../../../../desktop/im/lib/$(TARGET2)
	-$(MOVE) $(TARGET0) ../../../../desktop/im/lib/$(TARGET0)
	-$(MOVE) $(TARGET1) ../../../../desktop/im/lib/$(TARGET1)
	-$(MOVE) $(TARGET2) ../../../../desktop/im/lib/$(TARGET2)



