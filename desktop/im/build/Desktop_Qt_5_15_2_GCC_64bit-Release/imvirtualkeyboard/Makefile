install_target: first FORCE
	@test -d $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts || mkdir -p $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts
	$(QINSTALL_PROGRAM) ../../../../desktop/im/plugins/platforminputcontexts/$(TARGET) $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts/$(TARGET)
	-$(STRIP) --strip-unneeded $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/home/linux/Qt/5.15.2/gcc_64/plugins/platforminputcontexts/ 


install_imdata: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/pinyin/3rdparty/pinyin || mkdir -p $(INSTALL_ROOT)/usr/share/pinyin/3rdparty/pinyin
	$(QINSTALL) /home/linux/emb/14-desktop/im/imvirtualkeyboard/pinyininputmethod/pinyin/data $(INSTALL_ROOT)/usr/share/pinyin/3rdparty/pinyin/data

uninstall_imdata: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/pinyin/3rdparty/pinyin/data
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/pinyin/3rdparty/pinyin/ 


install: install_target install_imdata  FORCE

uninstall: uninstall_target uninstall_imdata  FORCE

